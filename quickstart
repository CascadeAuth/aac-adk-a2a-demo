#!/usr/bin/env bash
# README steps 1 to 4 in one script, for a first run. Each command is printed
# (with a leading +) before it runs. The README explains what each step does
# and why; read the two side by side. From a fresh clone:
#
#   VANTIS_CONTACT='you+vantis@example.com' TOURFEDIA_CONTACT='you+tourfedia@example.com' ./quickstart
#
# Use your real contact addresses. You sign in with GitHub four times in your
# browser, two per tenant, and acknowledge each permanent tenant registration.
# The quickstart runs the reservation scenario only, then renders its
# execution graph and opens it.
# Stop at the first command that fails.
set -e
# Both contact addresses are required.
: "${VANTIS_CONTACT:?Set VANTIS_CONTACT and TOURFEDIA_CONTACT to your real contact addresses}"
: "${TOURFEDIA_CONTACT:?Set VANTIS_CONTACT and TOURFEDIA_CONTACT to your real contact addresses}"
# aac-cli needs Python 3.11 or later; the python3 built into macOS is 3.9.
python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' ||
  { echo "python3 is $(python3 --version 2>&1); install Python 3.11 or later first (see the README)."; exit 1; }
# Run from the clone, wherever the script is started from.
cd "$(dirname "$0")"
# Step headings use ":" (do nothing) so the trace prints each heading once.
set -x

: "== 1. Install AAC CLI and prepare the example"
python3 -m venv .aac-tools
# Tracing is paused here only because it would print every line of the
# activate script. The command is: . .aac-tools/bin/activate
set +x
. .aac-tools/bin/activate
set -x
python -m pip install --upgrade aac-cli
aac --version
aeg --version
./demo prepare
mkdir -p .local
export AAC_CLI_HOME="$PWD/.local/aac"
cp config/trip-planner.yaml .local/trip-planner.yaml
cp config/booking.yaml .local/booking.yaml
# A rerun only: the development certificates expire (README section 6), and
# step 2 refuses an agent with an expired one. This renews the expired ones
# and says so; a first run has nothing to renew and prints nothing.
./demo renew

: "== 2. Register two tenants (${SECONDS}s so far)"
aac init \
  --profile vantis \
  --agent trip-planner \
  --agent-config .local/trip-planner.yaml \
  --layout container \
  --admin-url https://api.stage.cascadeauth.dev \
  --data-plane-url https://api.stage.cascadeauth.dev \
  --trust-url https://trust.stage.cascadeauth.dev \
  --idp github \
  --display-name 'Vantis Equity ADK Demo' \
  --contact "$VANTIS_CONTACT"
aac init \
  --profile tourfedia \
  --agent booking \
  --agent-config .local/booking.yaml \
  --layout container \
  --admin-url https://api.stage.cascadeauth.dev \
  --data-plane-url https://api.stage.cascadeauth.dev \
  --trust-url https://trust.stage.cascadeauth.dev \
  --idp github \
  --display-name 'Tourfedia ADK Demo' \
  --contact "$TOURFEDIA_CONTACT"

: "== 3. Explicitly trust and address the peer (${SECONDS}s so far)"
aac agent status --agent trip-planner --output json > .local/vantis-status.json
aac agent status --agent booking --output json > .local/tourfedia-status.json
VANTIS_TENANT=$(aac agent status --agent trip-planner --field tenant-id)
VANTIS_DOMAIN=$(aac agent status --agent trip-planner --field hosted-trust-domain)
VANTIS_ID=$(aac agent status --agent trip-planner --field workload-spiffe-id)
TOURFEDIA_TENANT=$(aac agent status --agent booking --field tenant-id)
TOURFEDIA_DOMAIN=$(aac agent status --agent booking --field hosted-trust-domain)
TOURFEDIA_ID=$(aac agent status --agent booking --field workload-spiffe-id)
# The trace shows each of the next two appends as a bare "cat". The text
# they append is below; it ends up in .local/trip-planner.yaml and
# .local/booking.yaml.
cat >> .local/trip-planner.yaml <<EOF
trust_anchors:
  tenant_ids: [$TOURFEDIA_TENANT]
spiffe_bundles:
  trust_domains: [$TOURFEDIA_DOMAIN]
https_trust:
  ca_files: ["$AAC_CLI_HOME/agents/booking/agent/ca.crt"]
destinations:
  tourfedia:
    url: https://booking:9443/a2a/v1
    audience_pattern: $TOURFEDIA_ID
    predicates:
      action: reserve_travel
    valid_for: +30m
    timeout_ms: 10000
EOF
cat >> .local/booking.yaml <<EOF
trust_anchors:
  tenant_ids: [$VANTIS_TENANT]
spiffe_bundles:
  trust_domains: [$VANTIS_DOMAIN]
EOF
aac init --profile vantis --agent trip-planner --agent-config .local/trip-planner.yaml
aac init --profile tourfedia --agent booking --agent-config .local/booking.yaml

: "== 4. Start and run (${SECONDS}s so far)"
./demo up
./demo run

: "== View this execution graph (${SECONDS}s so far)"
# The same render command ./demo run printed above, from the evidence that
# run just saved: its root token id selects the chain.
EVIDENCE=$(ls -t .runs/*.json | head -n 1)
ROOT=$(sed -n 's/.*"root_token_id": "\([0-9a-f]*\)".*/\1/p' "$EVIDENCE" | head -n 1)
GRAPH="${EVIDENCE%.json}.html"
aeg render --root-token-id "$ROOT" \
  --events "$AAC_CLI_HOME/agents/trip-planner/state/telemetry.jsonl" \
  --actions "$AAC_CLI_HOME/agents/trip-planner/state/actions.jsonl" \
  --events "$AAC_CLI_HOME/agents/booking/state/telemetry.jsonl" \
  --actions "$AAC_CLI_HOME/agents/booking/state/actions.jsonl" \
  --output "$GRAPH"

# The README commands are done; the rest only opens the graph and reports.
set +x
OPENED=no
if xdg-open "$GRAPH" >/dev/null 2>&1 || open "$GRAPH" >/dev/null 2>&1; then OPENED=yes; fi
echo
echo "Done in ${SECONDS}s. Your execution graph (open it in a browser if it did not open):"
echo "  $PWD/$GRAPH"
if [ "$OPENED" = no ]; then
  # A server or VM without a desktop: the graph is one file, so copy it out.
  echo
  echo "No browser opened here. The graph is one file that opens with no server, so"
  echo "copy it to a machine that has a browser. On that machine, from a Multipass VM:"
  echo "  multipass transfer \"$HOSTNAME:$PWD/$GRAPH\" ~/Downloads/"
  # Over SSH, the address this session arrived on; IPv6 needs brackets in scp.
  ADDRESS="<this machine's address>"
  if [ -n "$SSH_CONNECTION" ]; then ADDRESS=$(echo "$SSH_CONNECTION" | cut -d' ' -f3); fi
  case "$ADDRESS" in *:*) ADDRESS="[$ADDRESS]" ;; esac
  echo "or from a server you reach with SSH (if this address does not work, use the"
  echo "name you ssh to):"
  echo "  scp \"$USER@$ADDRESS:$PWD/$GRAPH\" ~/Downloads/"
fi
echo
echo "Quickstart demo completed successfully."
echo
echo "The two agents are still running in Docker. When you want to stop them,"
echo "run this in the aac-adk-a2a-demo folder:"
echo '  AAC_CLI_HOME="$PWD/.local/aac" ./demo down'
echo
echo 'Optional, before stopping: README step 4 shows the other outcome of the same'
echo 'order. The fare rises to $9,500, above the $8,000 Tourfedia may spend, so its'
echo 'booking agent declines:'
echo '  AAC_CLI_HOME="$PWD/.local/aac" ./demo run fare-change'
echo
echo 'To drive the same run with your own model instead of the script, see README'
echo 'section 5.'
